# Copy to .env (never commit .env) and fill in your own values.

# Required. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: enables the weather search tool. Free key from https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides (defaults shown)
# Models are chosen automatically from what your Groq account offers
# (preferences in car_rental/models.py). Set these only to force a model.
# GROQ_MAIN_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# MESSAGES_PER_SESSION_PER_HOUR=20
# MESSAGES_PER_DAY=300
# DEMO_DAYS_AHEAD=180
